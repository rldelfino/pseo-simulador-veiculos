/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://cloud.umami.is; style-src 'self' 'unsafe-inline' fonts.googleapis.com; font-src fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://cloudflareinsights.com https://cloud.umami.is https://api-gateway.umami.dev; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/styles.css
  Cache-Control: public, max-age=31536000, immutable

/logo-header.webp
  Cache-Control: public, max-age=86400, must-revalidate

/logo-full.png
  Cache-Control: public, max-age=86400, must-revalidate

/og-image.png
  Cache-Control: public, max-age=86400, must-revalidate

/calculo.js
  Cache-Control: public, max-age=3600, must-revalidate

# /embed é feito para ficar dentro de <iframe> em outros sites: libera o enquadramento só
# nesta rota (o resto do site segue com X-Frame-Options DENY e frame-ancestors 'none').
# O '!' remove o cabeçalho herdado da regra /* antes de definir o específico.
/embed
  ! X-Frame-Options
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; frame-ancestors *; base-uri 'self'; form-action 'none'
  Cache-Control: public, max-age=3600, must-revalidate
